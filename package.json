{
  "name": "design-goods",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/check-csp.mjs && node scripts/check-catalog.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "og": "node scripts/og-png.mjs",
    "audit:ci": "npm audit --omit=dev --audit-level=moderate",
    "doctor": "npx react-doctor@latest",
    "test:security": "node services/order-service/selftest.cjs && node services/payment-service/selftest.cjs && node services/cart-service/selftest.cjs && node services/api-gateway/rate-limit.test.cjs && node services/api-gateway/trust-proxy.test.cjs && node services/test/auth-security.test.cjs && node scripts/check-csp.mjs && node scripts/check-catalog.mjs",
    "test:csp": "node scripts/check-csp.mjs",
    "test:catalog": "node scripts/check-catalog.mjs",
    "test:auth": "node services/test/auth-security.test.cjs",
    "test:gateway": "node services/api-gateway/rate-limit.test.cjs && node services/api-gateway/trust-proxy.test.cjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "@astrojs/sitemap": "^3.4.1",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/inter": "^5.2.8",
    "astro": "^5.16.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
