# Copy to `.env` for local dev, or set PUBLIC_API_URL in your deploy
# platform's build environment for production.
#
# This is the base URL the storefront calls to place orders. It must point
# at the running API gateway (which proxies /api/orders -> order-service).
# Astro inlines PUBLIC_-prefixed vars into the client bundle at build time,
# so the production value must be set BEFORE building/deploying.
#
# Local dev (native services via start-services.ps1):
PUBLIC_API_URL=http://localhost:3001
#
# Production (example — replace with your deployed gateway URL):
# PUBLIC_API_URL=https://api.yourstore.com
