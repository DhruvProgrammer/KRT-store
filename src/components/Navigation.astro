---
import SearchModal, { type SearchProduct, type SearchExtra } from "./SearchModal";
import { products } from "../data/products";
import { extras } from "../data/extras";

const links = [
  { href: "/", label: "Home" },
  { href: "/store", label: "Store" },
  { href: "/extras", label: "Extras" },
  { href: "/#contact", label: "Contact" }
];

const announcement = "Free updates for life · 30-day refund";

const searchProducts: SearchProduct[] = products.map((p) => ({
  slug: p.slug,
  name: p.name,
  description: p.description,
  tag: p.tag,
  category: p.category
}));

const searchExtras: SearchExtra[] = extras.map((e) => ({
  slug: e.slug,
  name: e.name,
  description: e.description,
  tag: e.tag,
  category: e.category
}));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg-soft/90 backdrop-blur-xl" data-navigation>
  <div class="hidden border-b border-line/60 md:block">
    <div class="container mx-auto flex h-9 items-center justify-between gap-2 px-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-ink-muted sm:px-6 lg:px-8">
      <p class="flex items-center gap-2 truncate">
        <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-accent shadow-[0_0_10px_rgba(0,162,255,0.7)]"></span>
        <span class="truncate">{announcement}</span>
      </p>
      <div class="hidden items-center gap-4 sm:flex">
        <a href="/store" class="transition hover:text-ink">Browse store</a>
        <span aria-hidden="true" class="opacity-30">·</span>
        <a href="/#contact" class="transition hover:text-ink">Contact</a>
      </div>
    </div>
  </div>

  <div class="container mx-auto flex h-16 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="group flex items-center gap-2" aria-label="KRT store home">
      <span class="grid h-9 w-9 place-items-center rounded-xl bg-accent font-black text-ink-inverse shadow-[0_0_18px_rgba(0,162,255,0.45)] transition group-hover:scale-105">
        K
      </span>
      <span class="text-base font-black tracking-[-0.04em] text-ink truncate">KRT store</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary navigation">
      {links.map((link) => (
        <a
          href={link.href}
          class="rounded-full px-4 py-2 text-sm font-semibold text-ink-muted transition hover:bg-slate-800/40 hover:text-ink"
        >
          {link.label}
        </a>
      ))}
    </nav>

    {/* DESKTOP header buttons */}
    <div class="hidden items-center gap-2 md:flex">
      <a
        href="/login"
        class="inline-flex h-11 items-center gap-2 rounded-full border border-line bg-surface-ink px-4 text-xs font-bold text-ink-muted transition hover:border-accent/40 hover:bg-surface-bright hover:text-ink"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
        <span>Sign in</span>
      </a>

      <button
        type="button"
        data-open-search
        aria-label="Open search"
        title="Search (⌘K)"
        class="hidden h-10 items-center gap-2 rounded-full border border-line bg-surface-ink px-4 text-xs font-bold text-ink-muted transition hover:border-accent/40 hover:bg-surface-bright md:inline-flex"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span>Search</span>
        <span aria-hidden="true" class="hidden rounded border border-line bg-surface px-1.5 py-0.5 text-[10px] font-black uppercase tracking-[0.18em] text-ink-muted sm:inline-block">
          ⌘K
        </span>
      </button>

      <a
        href="/cart"
        aria-label="Open cart"
        class="relative inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-surface-ink text-ink transition hover:border-accent/40 hover:bg-surface-bright"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span
          data-cart-count
          class="pointer-events-none absolute -right-1 -top-1 hidden h-5 min-w-[1.25rem] place-items-center rounded-full bg-accent px-1 text-[10px] font-black text-white shadow-[0_0_12px_rgba(0,162,255,0.5)]"
        >
          <span data-cart-count-text>0</span>
        </span>
      </a>

      <a
        href="/store"
        class="hidden items-center gap-2 rounded-full bg-accent px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-white shadow-[0_0_22px_rgba(0,162,255,0.35)] transition hover:bg-accent-bright hover:shadow-[0_0_30px_rgba(0,162,255,0.55)] md:inline-flex"
      >
        Shop now
      </a>
    </div>

    {/* MOBILE header buttons */}
    <div class="flex items-center gap-1 md:hidden">
      <a
        href="/login"
        class="hidden h-11 items-center gap-1.5 rounded-full px-3 text-xs font-bold text-ink-muted transition hover:text-ink sm:inline-flex"
      >
        Sign in
      </a>

      <button
        type="button"
        data-open-search
        aria-label="Open search"
        title="Search (⌘K)"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-surface-ink text-ink transition hover:border-accent/40 hover:bg-surface-bright"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>

      <a
        href="/cart"
        aria-label="Open cart"
        class="relative inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-surface-ink text-ink transition hover:border-accent/40 hover:bg-surface-bright"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span
          data-cart-count
          class="pointer-events-none absolute -right-1 -top-1 hidden h-5 min-w-[1.25rem] place-items-center rounded-full bg-accent px-1 text-[10px] font-black text-white shadow-[0_0_12px_rgba(0,162,255,0.5)]"
        >
          <span data-cart-count-text>0</span>
        </span>
      </a>

      <button
        type="button"
        data-mobile-trigger
        aria-label="Open menu"
        aria-expanded="false"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-surface-ink text-ink transition hover:bg-surface-bright active:scale-95 active:border-accent/60"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

{/* Mobile slide-in drawer backdrop */}
<div class="fixed inset-0 z-40 bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden" data-mobile-backdrop></div>

{/* Mobile slide-in drawer */}
<div
  class="fixed top-0 right-0 z-50 h-full w-[300px] translate-x-full bg-bg-soft shadow-[0_0_40px_rgba(0,0,0,0.5)] transition-transform duration-300 ease-out md:hidden"
  data-mobile-panel
>
  <div class="flex h-full flex-col overflow-y-auto">
    <div class="flex items-center justify-between border-b border-line/60 px-4 py-3">
      <span class="text-sm font-bold uppercase tracking-widest text-ink">Menu</span>
      <button
        type="button"
        data-mobile-close
        aria-label="Close menu"
        class="grid h-10 w-10 place-items-center rounded-full border border-line bg-surface-ink text-ink transition hover:bg-surface-bright"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav class="flex flex-col gap-1 px-3 py-2" aria-label="Mobile primary">
      <p class="px-3 pt-3 pb-2 text-[11px] font-black uppercase tracking-[0.2em] text-ink-muted">Browse</p>
      <a href="/" class="block rounded-xl px-4 py-3 text-base font-semibold text-ink transition hover:bg-surface">Home</a>
      <a href="/store" class="block rounded-xl px-4 py-3 text-base font-semibold text-ink transition hover:bg-surface">Store</a>
      <a href="/extras" class="block rounded-xl px-4 py-3 text-base font-semibold text-ink transition hover:bg-surface">Extras</a>
      <a href="/#contact" class="block rounded-xl px-4 py-3 text-base font-semibold text-ink transition hover:bg-surface">Contact</a>

      <p class="px-3 pt-5 pb-2 text-[11px] font-black uppercase tracking-[0.2em] text-ink-muted">Account</p>
      <a href="/login" class="block rounded-xl px-4 py-3 text-base font-semibold text-ink transition hover:bg-surface">Sign in</a>
      <a href="/signup" class="block rounded-xl px-4 py-3 text-base font-semibold text-ink transition hover:bg-surface">Create account</a>
      <a href="/profile" class="block rounded-xl px-4 py-3 text-base font-semibold text-ink transition hover:bg-surface">Profile</a>
      <a href="/settings" class="block rounded-xl px-4 py-3 text-base font-semibold text-ink transition hover:bg-surface">Settings</a>
      <a href="/cart" class="block rounded-xl px-4 py-3 text-base font-semibold text-ink transition hover:bg-surface">Cart</a>

      <a href="/store" class="mt-4 block rounded-xl bg-accent px-4 py-3 text-center text-base font-bold text-white shadow-[0_0_22px_rgba(0,162,255,0.35)] transition hover:bg-accent-bright">
        Browse store
      </a>
    </nav>

    <div class="mt-auto border-t border-line/60 px-4 py-3">
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[11px] font-bold uppercase tracking-[0.18em] text-ink-muted">
        <a href="/privacy" class="transition hover:text-ink">Privacy</a>
        <span aria-hidden="true" class="opacity-30">·</span>
        <a href="/terms" class="transition hover:text-ink">Terms</a>
        <span aria-hidden="true" class="opacity-30">·</span>
        <a href="/#contact" class="transition hover:text-ink">Contact</a>
      </div>
    </div>
  </div>
</div>

{/* On-demand React singleton — only the search modal needs React (for combobox state). */}
<SearchModal client:load products={searchProducts} extras={searchExtras} />

<script is:inline>
  (function () {
    const init = () => {
      // ============ Cart badge sync ============
      const STORAGE_KEY = "dg-cart";
      const BAD = /<|>|javascript:|data:|@import|url\(|expression\(/i;
      const MAX_QTY = 99;

      const validateGradient = (v) => {
        if (typeof v !== "string") return false;
        const t = v.trim();
        if (t.length === 0 || t.length > 500) return false;
        return !BAD.test(t);
      };
      const safeNumber = (v, min, max) => {
        const n = Number(v);
        return Number.isFinite(n) && n >= min && n <= max;
      };
      const validateItem = (raw) => {
        if (!raw || typeof raw !== "object") return false;
        if (typeof raw.slug !== "string" || raw.slug.length === 0 || raw.slug.length > 120) return false;
        if (typeof raw.name !== "string" || raw.name.length === 0 || raw.name.length > 200) return false;
        if (!safeNumber(raw.price, 0, 100000)) return false;
        if (!safeNumber(raw.quantity, 1, MAX_QTY)) return false;
        return validateGradient(raw.gradient);
      };

      const readItems = () => {
        try {
          const raw = window.localStorage.getItem(STORAGE_KEY);
          if (!raw) return [];
          const items = JSON.parse(raw);
          if (!Array.isArray(items)) return [];
          const valid = items.filter(validateItem);
          return valid;
        } catch (e) {
          return [];
        }
      };

      const readCount = () =>
        readItems().reduce((sum, item) => sum + Number(item.quantity || 0), 0);

      const updateBadges = () => {
        const count = readCount();
        document.querySelectorAll("[data-cart-count]").forEach((b) => {
          const text = b.querySelector("[data-cart-count-text]");
          if (text) text.textContent = String(count);
          b.classList.toggle("hidden", count === 0);
          b.classList.toggle("grid", count > 0);
        });
      };

      updateBadges();
      window.addEventListener("cart:update", updateBadges);
      window.addEventListener("storage", (event) => {
        if (event.key === STORAGE_KEY) updateBadges();
      });

      // ============ Search open (button + shortcut) ============
      const openSearch = () => window.dispatchEvent(new CustomEvent("krt:open-search"));
      document.querySelectorAll("[data-open-search]").forEach((btn) =>
        btn.addEventListener("click", (event) => {
          event.preventDefault();
          openSearch();
        })
      );
      document.addEventListener("keydown", (event) => {
        if ((event.key === "k" || event.key === "K") && (event.metaKey || event.ctrlKey)) {
          event.preventDefault();
          openSearch();
        }
      });

        // ============ Mobile menu toggle (slide from right) ============
        const panel = document.querySelector("[data-mobile-panel]");
        const backdrop = document.querySelector("[data-mobile-backdrop]");
        const trigger = document.querySelector("[data-mobile-trigger]");
        const closeBtn = document.querySelector("[data-mobile-close]");
        if (panel) {
          const setOpen = (open) => {
            panel.classList.toggle("translate-x-full", !open);
            panel.classList.toggle("translate-x-0", open);
            if (backdrop) {
              backdrop.classList.toggle("pointer-events-none", !open);
              backdrop.classList.toggle("opacity-0", !open);
              backdrop.classList.toggle("opacity-100", open);
              backdrop.classList.toggle("pointer-events-auto", open);
            }
            if (trigger) {
              trigger.setAttribute("aria-expanded", String(open));
              trigger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
            }
          };
          const toggleOpen = () => setOpen(panel.classList.contains("translate-x-full"));
          if (trigger) {
            trigger.addEventListener("click", (event) => {
              event.preventDefault();
              event.stopPropagation();
              toggleOpen();
            });
          }
          if (closeBtn) {
            closeBtn.addEventListener("click", () => setOpen(false));
          }
          if (backdrop) {
            backdrop.addEventListener("click", () => setOpen(false));
          }
          window.addEventListener("krt:toggle-menu", toggleOpen);
          panel.querySelectorAll("a").forEach((anchor) =>
            anchor.addEventListener("click", () => setOpen(false))
          );
          document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && panel.classList.contains("translate-x-full")) {
              setOpen(false);
            }
          });
          // Auto-close the mobile panel if the viewport grows past the md breakpoint.
          const mq = window.matchMedia("(min-width: 768px)");
          const onMq = (e) => {
            if (e.matches) setOpen(false);
          };
          mq.addEventListener("change", onMq);
          // Initial state: closed
          setOpen(false);
        }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    // Re-initialize on Astro View Transitions
    document.addEventListener("astro:after-swap", init);
  })();
</script>