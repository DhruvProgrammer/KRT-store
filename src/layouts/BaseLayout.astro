---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { buildCsp } from "../data/csp.js";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, image, canonical, noindex = false } = Astro.props;
const siteTitle = "KRT store";
const siteDescription = description;
// ponytail: the domain comes from the `site` option in astro.config.mjs
// (Astro exposes it as import.meta.env.SITE), never from Astro.url.origin —
// the head must not be able to drift from the canonicals and the sitemap.
const siteUrl = (import.meta.env.SITE || Astro.url.origin).replace(/\/+$/, "");
const pageImage = image ? new URL(image, siteUrl).href : `${siteUrl}/og.png`;
const pageImageAlt = image ? title : `${siteTitle} — premium plugins, templates, and design assets`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, `${siteUrl}/`).href;
// ponytail: the policy lives in src/data/csp.js and is delivered TWICE: as a
// real HTTP header (public/_headers) and as the <meta> tag below. The dev
// server never reads _headers, so the tag is what keeps dev protected; the
// header is what makes the policy real in production. The tag is built from
// PUBLIC_API_URL, so connect-src names the API origin the browser may talk to.
const csp = buildCsp(import.meta.env.PUBLIC_API_URL);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteTitle,
  url: siteUrl,
  // ponytail: the logo was favicon.svg, a 100x100 viewBox with no intrinsic
  // size. Google requires an Organization logo of at least 112x112 px, and
  // the 512x512 PNG the og generator already produces (public/brand/
  // logo-512.png) was generated for exactly this and wired to nothing.
  logo: `${siteUrl}/brand/logo-512.png`,
  sameAs: [
    "https://twitter.com/krtstore",
    "https://github.com/krtstore"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteTitle,
  url: siteUrl,
  potentialAction: {
    "@type": "SearchAction",
    // ponytail: the trailing slash matches the canonical of the page it
    // points at ("/store/"), so the search target is not a second URL shape.
    target: `${siteUrl}/store/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

// ponytail: JSON.stringify does NOT escape "<", so a schema value holding a
// closing script tag would terminate the element early and inject markup into
// the page. Replacing "<" with its -validation JSON escape (backslash-u003c)
// keeps the payload parseable — JSON.parse accepts the escape — while making a
// closing tag unrepresentable.
//
// NOTE: never write a literal script tag in this comment. Astro's compiler
// scans the whole file for script blocks, so a tag inside a comment silently
// turns the rest of the file into script content and breaks Vite's dep scan.
const ldJson = (data: unknown) => JSON.stringify(data).replace(/</g, "\\u003c");

// ponytail: there is deliberately NO hand-rolled hash list here. Only the build
// knows the SHA-256 of each script Astro inlines (the island hydrator, the view
// transition router, component scripts), so a hand-written list can only ever
// cover the JSON-LD blocks — which script-src does not govern anyway. A partial
// list is worse than none: the browser blocks the hashless scripts, no island
// hydrates, and every interactive page renders blank. The JSON-LD schemas below
// need no hash entries for the same reason.
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#161a22" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={siteDescription} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* ponytail: a canonical on a noindex page is contradictory — it asks the
        crawler to consolidate onto a URL we are also telling it to drop
        (the 404 page pointed its canonical at a URL that itself 404s). */}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={pageImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image" content={pageImage} />
    <meta name="twitter:image:alt" content={pageImageAlt} />

    <!-- Structured data: Organization + WebSite (every page) -->
    <script type="application/ld+json" set:html={ldJson(organizationSchema)} is:inline></script>
    <script type="application/ld+json" set:html={ldJson(websiteSchema)} is:inline></script>

    <!--
      Security headers.

      ponytail: the same policy is served as a real HTTP header in
      public/_headers -- a <meta> policy ignores frame-ancestors and cannot
      cover anything the browser fetched before it parsed the tag. The tag
      stays because the Astro dev/preview server never reads _headers, and
      because a browser enforces BOTH (the effective policy is the
      intersection), so the tag can only make the page stricter. Both strings
      come from src/data/csp.js; scripts/check-csp.mjs fails if they drift.

      ponytail: script-src uses 'unsafe-inline' because Astro inlines the island
      hydrator and component scripts and no stable hand-written hash list can
      cover them (a partial list blocks them and blanks every page — see above).
      A stricter policy needs a nonce per response, which is only possible if
      this moves to a server/SSR render; the current build is fully static.
      Narrowing script-src to a hash list is a follow-up, not a blind change.

      style-src keeps 'unsafe-inline' as well: the React `style={{background}}`
      product gradients rely on it. A style injection cannot execute script, so
      this is the cheaper of the two exceptions.

      connect-src MUST keep the API gateway origin or every auth/checkout fetch
      is blocked. object-src 'none' is added because default-src 'self' still
      permits same-origin <object>/<embed>. frame-src 'none' stays here
      because frame-ancestors is IGNORED in a meta tag; frame-ancestors
      'none' lives in the header, where it works.
    -->
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="font-sans">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
