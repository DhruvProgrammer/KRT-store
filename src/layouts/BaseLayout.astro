---
import "../styles/global.css";
import { createHash } from "node:crypto";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, image, canonical, noindex = false } = Astro.props;
const siteTitle = "KRT store";
const siteDescription = description;
const siteUrl = Astro.url.origin;
const pageImage = image ? new URL(image, siteUrl).href : `${siteUrl}/og.svg`;
const canonicalUrl = canonical ?? Astro.url.href;
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "";
const connectSrc = apiUrl ? `'self' ${apiUrl}` : "'self'";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteTitle,
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  sameAs: [
    "https://twitter.com/krtstore",
    "https://github.com/krtstore"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteTitle,
  url: siteUrl,
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteUrl}/store?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

// ponytail: CSP script-src needs SHA-256 hashes for the JSON-LD inline blocks
// so we can drop 'unsafe-inline' entirely. The blocks vary per page (siteUrl
// is the page origin), so hashes are computed at render time.
const sha256 = (s: string) =>
  `'sha256-${createHash("sha256").update(s, "utf8").digest("base64")}'`;
const orgHash = sha256(JSON.stringify(organizationSchema));
const webHash = sha256(JSON.stringify(websiteSchema));
const jsonLdHashes = `${orgHash} ${webHash}`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#161a22" />
    <meta name="description" content={siteDescription} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={pageImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={pageImage} />

    <!-- Structured data: Organization + WebSite (every page) -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline></script>

    <!--
      Security headers via <meta> tags. Static-only sites are served from
      a CDN/edge that should also set these as real HTTP response headers.
      Astro meta tags are a useful fallback but should NOT be the only place
      these are enforced.
    -->
    <!-- ponytail: connect-src must allow the API gateway origin, otherwise the
         browser blocks the checkout fetch and no order/receipt email is ever sent.
         The origin is derived from PUBLIC_API_URL at build time (see astro.config.mjs
         for the deploy-time HTTPS check). frame-ancestors is intentionally omitted:
         it is ignored in a <meta> CSP and only works as an HTTP header, so frame-src
         'none' (valid in meta) provides the clickjacking protection. 'unsafe-eval'
         is dropped because nothing in the source uses eval()/new Function(). Inline
         is replaced by sha256-* hashes for the JSON-LD blocks; everything else is
         an external script bundled by Astro. -->
    <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' ${jsonLdHashes}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ${connectSrc}; frame-src 'none'; base-uri 'self'; form-action 'self';`} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="font-sans">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
