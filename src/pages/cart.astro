---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer";
import CartList from "../components/CartList";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const title = "Cart — KRT store";
const description = "Review the digital goods in your cart and proceed to checkout.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <Navigation />
  <main id="main">
    <Breadcrumbs
      class="container mx-auto flex flex-wrap items-center gap-2 px-4 pt-6 sm:px-6 lg:px-8"
      items={[{ label: "Home", href: "/" }, { label: "Cart" }]}
    />
    <CartList client:load />
  </main>
  <Footer client:load />
</BaseLayout>
