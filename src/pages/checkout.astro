---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer";
import CheckoutForm from "../components/CheckoutForm";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const title = "Checkout — KRT store";
const description = "Complete your order and receive instant download links for your digital goods.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <Navigation />
  <main id="main">
    <Breadcrumbs
      class="container mx-auto flex flex-wrap items-center gap-2 px-4 pt-6 sm:px-6 lg:px-8"
      items={[{ label: "Home", href: "/" }, { label: "Cart", href: "/cart/" }, { label: "Checkout" }]}
    />
    <CheckoutForm client:load />
  </main>
  <Footer client:load />
</BaseLayout>
