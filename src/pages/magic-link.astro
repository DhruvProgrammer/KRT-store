---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer";
import AuthForm from "../components/AuthForm";

const title = "Sign in with a magic link — KRT store";
const description = "Enter your email and we'll send you a secure sign-in link.";
---

<BaseLayout title={title} description={description}>
  <Navigation />
  <main id="main">
    <nav class="container mx-auto flex flex-wrap items-center gap-2 px-4 pt-6 text-xs font-bold uppercase tracking-[0.18em] text-ink-muted sm:px-6 lg:px-8" aria-label="Breadcrumb">
      <a href="/" class="transition hover:text-ink">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/login" class="transition hover:text-ink">Sign in</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink">Magic link</span>
    </nav>
    <AuthForm client:load mode="login" method="magic-link" />
  </main>
  <Footer client:load />
</BaseLayout>