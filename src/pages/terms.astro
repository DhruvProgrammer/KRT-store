---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer";
import LegalPage from "../components/LegalPage";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { termsSections } from "../data/terms-sections";

const title = "Terms of Service | KRT store";
const description = "Terms and conditions for using the KRT store.";
---

<BaseLayout title={title} description={description}>
  <Navigation />
  <main id="main">
    <!-- ponytail: /terms is indexable and in the sitemap, so it gets
         the same breadcrumb (and the same BreadcrumbList schema) as
         every other indexable page. -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        class="pt-8"
        items={[{ label: "Home", href: "/" }, { label: "Terms of service" }]}
      />
    </div>
    <LegalPage
      client:load
      eyebrow="Terms"
      title="Terms of service"
      lead="The legalese, in plain language. The full licence text delivered with each purchase is the binding version."
      lastUpdated="Q2 2026"
      sections={termsSections}
    />
  </main>
  <Footer client:load />
</BaseLayout>
