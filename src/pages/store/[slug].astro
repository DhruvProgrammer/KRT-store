---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer";
import ProductDetail from "../../components/ProductDetail";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { products, type Product } from "../../data/products";
import { categoryBySlug } from "../../data/categories";
import { LICENSE_TIERS, licensePrice } from "../../data/licenses";
import { REFUND_POLICY, UPDATE_POLICY } from "../../data/policy";
import { metaDescription, pageTitle, productTitle } from "../../data/seo";

export const getStaticPaths = () =>
  products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));

interface Props {
  product: Product;
}

const { product } = Astro.props as Props;

// ponytail: the SERP title carries the keyword. "Clarity - KRT store" has
// no chance of ranking for "accessibility audit plugin"; the old title spent
// a third of a 19-character line on the brand.
const title = pageTitle(product.seoTitle);
// ponytail: the long description is richer copy that was already in the data
// model but was only ever rendered as body text. It is the better meta
// description (140-160 chars) and it is already written.
const description = metaDescription(product.longDescription);

const siteUrl = (import.meta.env.SITE || Astro.url.origin).replace(/\/+$/, "");
const pageUrl = new URL(Astro.url.pathname, `${siteUrl}/`).href;
const category = categoryBySlug(product.category);

// ponytail: the page sells THREE license tiers at three different prices, so
// the schema publishes three offers rather than one. The base price is the
// lowest, which is also what the page renders by default, so the structured
// data matches the visible price.
const offers = LICENSE_TIERS.map((tier) => ({
  "@type": "Offer",
  name: `${product.name} — ${tier.label} licence`,
  sku: `${product.slug}-${tier.id}`,
  price: licensePrice(product.price, tier.id).toFixed(2),
  priceCurrency: "USD",
  availability: "https://schema.org/InStock",
  url: pageUrl,
  itemCondition: "https://schema.org/NewCondition",
  seller: { "@type": "Organization", name: "KRT store" },
  // ponytail: Google requires applicableCountry on a MerchantReturnPolicy,
  // and returnPolicyCountry since March 2025. Without them the merchant
  // listing reports "Missing field applicableCountry" on all 12 product
  // pages. returnMethod is deliberately absent: Google's enum is
  // ReturnAtKiosk / ReturnByMail / ReturnInStore, and a ZIP download cannot
  // be returned by post -- any of those three would be a false claim.
  hasMerchantReturnPolicy: {
    "@type": "MerchantReturnPolicy",
    applicableCountry: REFUND_POLICY.applicableCountry,
    returnPolicyCountry: REFUND_POLICY.applicableCountry,
    merchantReturnDays: REFUND_POLICY.windowDays,
    returnPolicyCategory: "https://schema.org/MerchantReturnFiniteReturnWindow",
    returnFees: "https://schema.org/FreeReturn"
  }
}));

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  // ponytail: the schema name is the visible headline, not the bare product
  // name. Google wants the structured name to match what is on the page, and
  // the <h1> is "Clarity - Accessibility Audit Plugin for Figma & Chrome".
  name: productTitle(product),
  description,
  image: `${siteUrl}/og/${product.slug}.png`,
  brand: { "@type": "Brand", name: "KRT store" },
  category: category?.label ?? product.category,
  sku: product.slug,
  offers,
  // ponytail: no aggregateRating. The old numbers were hardcoded seed
  // constants with no review collection behind them, which is fabricated
  // review markup (Google manual-action risk) and a consumer-protection
  // problem. It comes back only when real reviews exist.
  additionalProperty: [
    { "@type": "PropertyValue", name: "Version", value: product.version },
    { "@type": "PropertyValue", name: "File size", value: product.fileSize },
    { "@type": "PropertyValue", name: "License", value: LICENSE_TIERS.map((t) => t.label).join(" / ") },
    ...product.compatibility.map((c) => ({
      "@type": "PropertyValue",
      name: "Compatibility",
      value: c
    })),
    { "@type": "PropertyValue", name: "Updates", value: UPDATE_POLICY.short }
  ]
};

// ponytail: JSON.stringify does not escape "<", so a value containing
// "</script>" would close the element early and inject markup.
const ldJson = (data: unknown) => JSON.stringify(data).replace(/</g, "\\u003c");
---

<BaseLayout title={title} description={description} image={`/og/${product.slug}.png`}>
  <Navigation />
  <main id="main" class="container mx-auto px-4 pt-6 pb-20 sm:px-6 lg:px-8">
    <Breadcrumbs
      class="mb-6"
      items={[
        { label: "Home", href: "/" },
        { label: "Store", href: "/store/" },
        { label: product.name }
      ]}
    />

    <ProductDetail client:load product={product} />
  </main>

  <script type="application/ld+json" set:html={ldJson(productSchema)} is:inline></script>

  <Footer client:load />
</BaseLayout>
