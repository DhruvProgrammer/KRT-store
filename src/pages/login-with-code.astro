---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer";
import AuthForm from "../components/AuthForm";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const title = "Sign in with a code — KRT store";
const description = "Enter your email and we'll send you a 6-digit sign-in code.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <Navigation />
  <main id="main">
    <Breadcrumbs
      class="container mx-auto flex flex-wrap items-center gap-2 px-4 pt-6 sm:px-6 lg:px-8"
      items={[{ label: "Home", href: "/" }, { label: "Sign in", href: "/login/" }, { label: "With a code" }]}
    />
    <AuthForm client:load mode="login" method="otp" />
  </main>
  <Footer client:load />
</BaseLayout>