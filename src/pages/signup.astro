---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer";
import AuthForm from "../components/AuthForm";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const title = "Create account — KRT store";
const description = "Create a KRT store account to track downloads, license keys, and orders.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <Navigation />
  <main id="main" class="container mx-auto px-4 pt-6 pb-20 sm:px-6 lg:px-8">
    <Breadcrumbs
      class="mb-6"
      items={[{ label: "Home", href: "/" }, { label: "Create account" }]}
    />

    <div class="mx-auto max-w-xl">
      <AuthForm client:load mode="signup" />
    </div>
  </main>
  <Footer client:load />
</BaseLayout>
