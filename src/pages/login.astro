---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer";
import AuthForm from "../components/AuthForm";

const title = "Sign in — KRT store";
const description = "Sign in to your KRT store account to access downloads and license keys.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <Navigation />
  <main id="main" class="container mx-auto px-4 pt-6 pb-20 sm:px-6 lg:px-8">
    <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="transition hover:text-ink">Home</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink">Sign in</span>
    </nav>

    <div class="mx-auto max-w-xl">
      <AuthForm client:load mode="login" method="password" />
    </div>

    <div class="mt-10 space-y-4 text-center">
      <p class="text-sm text-ink-muted">Or sign in with</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/login-with-code" class="inline-flex items-center justify-center gap-2 rounded-xl border border-line bg-surface/60 px-5 py-3 text-sm font-bold text-ink transition hover:border-accent/40 hover:bg-surface-bright hover:text-accent">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          <span>Sign in with a code</span>
        </a>
        <a href="/magic-link" class="inline-flex items-center justify-center gap-2 rounded-xl border border-accent/30 bg-accent/10 px-5 py-3 text-sm font-bold text-accent transition hover:bg-accent/20">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="19" x2="10" y2="19" />
          </svg>
          <span>Authorize by email (magic link)</span>
        </a>
      </div>
    </div>
  </main>
  <Footer client:load />
</BaseLayout>
